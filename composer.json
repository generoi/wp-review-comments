{
    "name": "generoi/wp-review-comments",
    "type": "wordpress-plugin",
    "license": "MIT",
    "description": "Click-to-comment website review for clients and the team, readable by Claude through MCP",
    "homepage": "https://github.com/generoi/wp-review-comments",
    "authors": [
        {
            "name": "Genero",
            "email": "info@genero.fi"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "laravel/pint": "^1.17",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11",
        "szepeviktor/phpstan-wordpress": "^2",
        "wordpress/mcp-adapter": "^0.7"
    },
    "suggest": {
        "wordpress/mcp-adapter": "Exposes the review abilities to Claude and other MCP clients"
    },
    "autoload": {
        "psr-4": {
            "GeneroWP\\ReviewComments\\": "src/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "automattic/jetpack-autoloader": false
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GeneroWP\\ReviewComments\\Tests\\": "tests/"
        }
    }
}
